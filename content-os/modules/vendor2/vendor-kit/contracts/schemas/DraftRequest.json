{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "data_class": {
      "type": "string",
      "enum": [
        "TEST_ONLY",
        "STAGING",
        "PRODUCTION"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "brief": {
      "$ref": "ContentBrief.json"
    },
    "evidence": {
      "$ref": "EvidenceBundle.json"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_provider_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost_usd": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"
        },
        "deadline_at": {
          "type": "string",
          "format": "date-time"
        },
        "max_transport_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": [
        "max_provider_requests",
        "max_tokens",
        "max_cost_usd",
        "deadline_at",
        "max_transport_attempts"
      ]
    }
  },
  "required": [
    "contract_version",
    "project_id",
    "data_class",
    "request_id",
    "brief",
    "evidence",
    "budget"
  ]
}
