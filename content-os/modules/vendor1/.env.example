# Copy to operator environment. Do not put secrets in git or the frontend bundle.
THBISON_MODE=MOCK
THBISON_DATA_DIR=/var/lib/thbison-seo-planning
THBISON_CODE_COMMIT=
# JSON map of bearer token -> { "project_id", "roles" }
THBISON_SERVICE_TOKENS={"replace-me-token-at-least-16":{"project_id":"test-thbison","roles":["planning"]}}
# Live OpenSEO MCP (optional). Leave empty to keep MOCK / S02 NOT_RUN_EXTERNAL.
OPENSEO_API_KEY=
THBISON_PROVIDER_REVISION=
THBISON_FRESHNESS_MS=2592000000
THBISON_CLOCK_NOW=
THBISON_DISABLE_CACHE=
