{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "data_class": {
      "type": "string",
      "enum": [
        "TEST_ONLY",
        "STAGING",
        "PRODUCTION"
      ]
    },
    "brief_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "brief_revision": {
      "type": "integer",
      "minimum": 1
    },
    "research_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        },
        "timezone": {
          "const": "Asia/Bangkok"
        },
        "domain": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      },
      "required": [
        "country_code",
        "language",
        "timezone",
        "domain"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "primary_keyword": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "secondary_keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "minItems": 0
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "minItems": 1
    },
    "outline": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "minItems": 1
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "minItems": 1
    },
    "product_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0
    },
    "proposed_publish_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "editorial_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "minItems": 0
    },
    "origin": {
      "type": "string",
      "enum": [
        "RESEARCH",
        "MANUAL"
      ]
    }
  },
  "required": [
    "contract_version",
    "project_id",
    "data_class",
    "brief_id",
    "brief_revision",
    "research_id",
    "scope",
    "title",
    "audience",
    "intent",
    "primary_keyword",
    "secondary_keywords",
    "questions",
    "outline",
    "evidence_requirements",
    "product_refs",
    "proposed_publish_at",
    "editorial_constraints",
    "origin"
  ]
}
